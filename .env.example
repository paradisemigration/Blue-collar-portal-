# Database Configuration
DATABASE_URL=your_neon_database_url_here

# Gmail SMTP Configuration for sending emails
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Application Configuration
NEXT_PUBLIC_APP_URL=https://gogethires.com
NODE_ENV=production

# Instructions for Gmail Setup:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account Settings > Security > 2-Step Verification
# 3. Generate an "App Password" for "Mail"
# 4. Use the generated 16-character password (not your regular Gmail password)
# 5. Set GMAIL_USER to your full Gmail address
# 6. Set GMAIL_APP_PASSWORD to the generated app password

# Example:
# GMAIL_USER=noreply@gogethires.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Security Notes:
# - Never commit this file with real credentials
# - Use strong, unique app passwords
# - Keep credentials secure and rotate them regularly
