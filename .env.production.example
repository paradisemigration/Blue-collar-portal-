# Go Get Hire - Production Environment Variables
# Copy this file to .env.production and update the values

# Site Configuration
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://gogethire.com
NEXT_PUBLIC_APP_NAME="Go Get Hire"

# Domain and SEO
NEXT_PUBLIC_DOMAIN=gogethire.com
NEXT_PUBLIC_COMPANY_NAME="Go Get Hire"

# Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=XXXXXXXXXX

# Email Configuration (if using contact forms)
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@gogethire.com
# EMAIL_PASS=your_email_password

# Database (if needed)
# DATABASE_URL=your_database_connection_string

# API Keys (if using external services)
# STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxx

# Security
# JWT_SECRET=your_jwt_secret_key
# NEXTAUTH_SECRET=your_nextauth_secret
# NEXTAUTH_URL=https://gogethire.com
